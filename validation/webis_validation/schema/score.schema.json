{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Webis-validáció: egy cím AI-pontozása",
  "description": "Az AI csak a címet (text) kapja. A signals pontjai 0–2, az összeg 0–8, a scaled = total / 8 (kezdeti, nem bizonyított feltevés). A span szó szerint szerepel a címben, 0 pontnál üres; a reason legfeljebb 15 szó. Az érvényesítést a scoring.validate_score végzi, mert a séma a szövegre vonatkozó szabályokat nem tudja kifejezni.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "signals", "total", "scaled"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {"const": "webis-clickbait-17"},
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curiosity_gap", "exaggeration", "emotional_pressure", "formal_noise"],
      "properties": {
        "curiosity_gap": {"$ref": "#/$defs/signal"},
        "exaggeration": {"$ref": "#/$defs/signal"},
        "emotional_pressure": {"$ref": "#/$defs/signal"},
        "formal_noise": {"$ref": "#/$defs/signal"}
      }
    },
    "total": {"type": "integer", "minimum": 0, "maximum": 8},
    "scaled": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason", "span"],
      "properties": {
        "score": {"type": "integer", "enum": [0, 1, 2]},
        "reason": {"type": "string"},
        "span": {"type": "string"}
      }
    }
  }
}
